{
  "name": "dragon-rush",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dragon-rush/web --filter @dragon-rush/server run dev",
    "build": "pnpm -r run build",
    "start": "node apps/server/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "sim": "tsx packages/sim/src/cli.ts",
    "env-server": "node packages/sim/dist/env-server.js",
    "combat-env-server": "node packages/sim/dist/combat-env-server.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
